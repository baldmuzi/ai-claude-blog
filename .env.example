# 数据库连接 URL
# Database connection URL

# MySQL 示例 (本地开发)
# MySQL example (local development)
DATABASE_URL="mysql://用户名:密码@localhost:3306/数据库名"
# DATABASE_URL="mysql://username:password@localhost:3306/database_name"

# SQLite 示例 (简单测试)
# SQLite example (simple testing)
# DATABASE_URL="file:./dev.db"

# 生产环境示例 (使用云数据库如 PlanetScale, Railway, etc.)
# Production example (using cloud database like PlanetScale, Railway, etc.)
# DATABASE_URL="mysql://username:password@host:3306/database?sslaccept=strict"
